<sdf version="1.6">
  <world name="greenhouse_world">
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.80 0.87 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Greenhouse floor -->
    <model name="greenhouse_floor">
      <static>true</static>
      <link name="floor_link">
        <pose>0 0 0.01 0 0 0</pose>
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>10 6 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>10 6 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.33 0.30 1</ambient>
            <diffuse>0.45 0.42 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Greenhouse left wall -->
    <model name="greenhouse_wall_left">
